# GCP
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=life-newsletter-media
# Firestore: set if your database ID is not "(default)" (e.g. FIRESTORE_DATABASE_ID=gregchronicles)
FIRESTORE_DATABASE_ID=

# Task auth (required for /tasks/* endpoints)
TASK_SECRET=your-random-secret

# Grok (xAI) - or use Secret Manager in production
GROK_API_KEY=your-grok-api-key
GROK_MODEL=grok-2-latest

# SendGrid (optional for local; use Secret Manager in prod)
SENDGRID_API_KEY=
SENDGRID_FROM=newsletter@example.com
SENDGRID_FROM_NAME=Life Newsletter

# Twilio (optional for local)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Unsubscribe link signing (optional; defaults to TASK_SECRET)
UNSUBSCRIBE_SECRET=

# URLs (for emails and links)
API_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

PORT=8080
